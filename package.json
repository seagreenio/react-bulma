{
  "name": "@seagreenio/react-bulma",
  "version": "1.0.0-rc.0",
  "description": "A Bulma component library for modern React.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seagreenio/react-bulma.git"
  },
  "homepage": "https://github.com/seagreenio/react-bulma#readme",
  "bugs": {
    "url": "https://github.com/seagreenio/react-bulma/issues"
  },
  "files": [
    "dist",
    "styles",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "node": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles": {
      "types": "./dist/styles.d.ts",
      "import": "./dist/styles.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsdown && bun scripts/build-styles.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/unit",
    "test:browser": "bun scripts/build-fixture-styles.ts && playwright test",
    "storybook": "bun run official:generate && bun scripts/build-fixture-styles.ts && storybook dev -p 6006 --no-open",
    "build-storybook": "bun run official:generate && bun scripts/build-fixture-styles.ts && storybook build",
    "format": "prettier --write .",
    "official:generate": "bun scripts/generate-official.ts",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "react": ">=17.0.2",
    "react-dom": ">=17.0.2"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "bulma": "1.0.4",
    "postcss": "^8.5.32",
    "postcss-selector-parser": "^7.1.7",
    "sass": "^1.107.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "cheerio": "^1.2.0",
    "liquidjs": "^10.30.1",
    "marked": "^18.1.3",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.6.5",
    "tsdown": "^0.23.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "publishConfig": {
    "access": "public",
    "tag": "rc"
  }
}
